			"key": "baseUrl",
			"value": "http://localhost:3000/api/v1",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "",
			"type": "string"
		},
		{
			"key": "cycleId",
			"value": "",
			"type": "string"
		},
		{
			"key": "symptomId",
			"value": "",
			"type": "string"
		},
		{
			"key": "moodId",
			"value": "",
			"type": "string"
		}
	],
