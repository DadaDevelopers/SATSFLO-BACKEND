{
	"info": {
		"_postman_id": "satsflow-api-collection",
		"name": "Satsflow API",
		"description": "Complete API collection for Satsflow - Period & Fertility Tracking Backend\n\n## Base URL\n- Local: http://localhost:3000/api/v1\n\n## Authentication\nMost endpoints require a Bearer token. After login, the access token is automatically saved to the collection variable.\n\n## Rate Limits\n- General: 100 requests/15 minutes\n- Auth endpoints: 5 requests/15 minutes\n- Sensitive data: 30 requests/minute",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
