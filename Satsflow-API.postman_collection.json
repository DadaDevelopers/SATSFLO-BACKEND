						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/resend-verification",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "resend-verification"]
						},
						"description": "Resend email verification link.\n\n**Rate Limit:** 5 requests/15 minutes"
					},
					"response": []
