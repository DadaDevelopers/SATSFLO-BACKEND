{
  "name": "satsflow-backend",
  "version": "1.0.0",
  "description": "Backend API for Satsflow - Period tracking app with Bitcoin Lightning rewards and community features",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:create": "dotenv -- node-pg-migrate --migrations-dir src/database/migrations create",
    "migrate:status": "node scripts/migration-status.js",
    "seed": "node src/database/seeds/index.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "echo \"Tests coming soon\" && exit 0",
    "generate-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
  },
  "keywords": [
    "period-tracking",
    "health",
    "bitcoin",
    "lightning-network",
    "api",
    "express",
    "postgresql"
  ],
  "author": "Dada Developers",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bech32": "^2.0.0",
    "bolt11": "^1.4.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "pg-format": "^1.0.4",
    "resend": "^6.9.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1"
  }
}
