# ===========================================
# SATSFLOW BACKEND - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ===========================================
# SUPABASE Configuration
# ===========================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ===========================================
# JWT Configuration
# ===========================================
# Generate secrets with: npm run generate-key
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# ENCRYPTION Configuration
# ===========================================
# Generate with: npm run generate-key
# IMPORTANT: This encrypts sensitive health data - keep this safe!
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_for_health_data

# ===========================================
# EMAIL Configuration (for password reset)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Satsflow <noreply@satsflow.com>

# ===========================================
# APP Configuration
# ===========================================
FRONTEND_URL=http://localhost:3001
APP_NAME=Satsflow
MAX_FILE_SIZE=5242880

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug

# ===========================================
# BITCOIN LIGHTNING (Dev 2 will configure)
# ===========================================
# LIGHTNING_NODE_URL=
# LIGHTNING_API_KEY=
