# ===========================================
# SATSFLOW BACKEND - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ===========================================
# PostgreSQL Database
# ===========================================
# You can use DATABASE_URL or the split DB_* variables below
DATABASE_URL=postgresql://satsflow_user:satsflow_secure_2026@localhost:5432/satsflow
DB_HOST=localhost
DB_PORT=5432
DB_NAME=satsflow
DB_USER=satsflow_user
DB_PASSWORD=satsflow_secure_2026
DB_SSL=false
DB_CONNECTION_TIMEOUT=10000

# ===========================================
# JWT Configuration
# ===========================================
# Generate secrets with: npm run generate-key
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# ENCRYPTION Configuration
# ===========================================
# Generate with: npm run generate-key
# IMPORTANT: This encrypts sensitive health data - keep this safe!
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_for_health_data

# ===========================================
# EMAIL Configuration (optional in development)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Satsflow <noreply@satsflow.com>

# ===========================================
# APP Configuration
# ===========================================
FRONTEND_URL=http://localhost:8080
DEEP_LINK_URL=satsflo://
WEBHOOK_SECRET=your_webhook_secret_here
ALLOWED_ORIGINS=*
APP_NAME=Satsflow
MAX_FILE_SIZE=5242880

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug

# ===========================================
# BITCOIN LIGHTNING
# ===========================================
BLINK_API_URL=https://api.blink.sv/graphql
BLINK_API_KEY=
BLINK_BTC_WALLET_ID=
BLINK_API_TIMEOUT_MS=10000
